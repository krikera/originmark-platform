# OriginMark API Configuration
# Copy this file to .env and customize for your environment

# Database Configuration
# Default is PostgreSQL (matches the docker-compose.yml setup)
DATABASE_URL=postgresql://originmark:originmark_password@localhost:5433/originmark_db

# CORS Configuration
# Comma-separated list of allowed origins (use * for development only)
CORS_ORIGINS=*

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here


# Telemetry (optional)
ENABLE_TELEMETRY=true
